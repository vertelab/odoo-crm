<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="linkedin_company_employee_wizard_form_view" model="ir.ui.view">
            <field name="name">linkedin.employee.wizard.form.lead</field>
            <field name="model">linkedin.employee.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="company_name" invisible="1"/>
                        <field name="res_id" invisible="1"/>
                        <field name="res_model" invisible="1"/>
                        <field name="resource_ref"/>
                    </group>
                    <notebook>
                        <page string="LinkedIn Employees">
                            <field name="line_ids" nolabel="1">
                                <tree create="false">
                                    <field name="name"/>
                                    <field name="position"/>
                                    <field name="public_profile"/>
                                    <field name="profile_urn"/>
                                    <field name="profile_url" optional="hide"/>
                                    <field name="email"/>
                                    <field name="location"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <footer>
                         <button name="action_create_employee_leads" type="object" class="btn btn-primary"
                            string="Create as Leads" groups="sales_team.group_sale_manager" display="always"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="linkedin_company_employee_wizard_form_view2" model="ir.ui.view">
            <field name="name">linkedin.employee.wizard.form.lead</field>
            <field name="model">linkedin.employee.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="company_name" invisible="1"/>
                        <field name="res_id" invisible="1"/>
                        <field name="res_model" invisible="1"/>
                        <field name="resource_ref"/>
                    </group>

                    <notebook>
                        <page string="LinkedIn Employees">
                            <field name="line_ids" nolabel="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="position"/>
                                    <field name="public_profile"/>
                                    <field name="profile_urn"/>
                                    <field name="profile_url" optional="hide"/>
                                    <field name="email"/>
                                    <field name="location"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                    <footer>
                        <button name="action_create_contact" type="object" class="btn btn-primary"
                            string="Generate Contact" groups="sales_team.group_sale_manager" display="always"/>
                        <button name="action_create_employee" type="object" class="btn btn-primary"
                            string="Generate Employee &amp; Contact" groups="sales_team.group_sale_manager" display="always"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>