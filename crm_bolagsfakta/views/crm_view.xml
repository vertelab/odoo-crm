<odoo>
    <data>
        <record id="crm_lead_view_form" model="ir.ui.view">
            <field name="name">crm.lead</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='lead']" position="attributes">
                    <attribute name="invisible">type not in ['lead', 'opportunity']</attribute>
                </xpath>
                <xpath expr="//page[@name='lead']//field[@name='partner_name']" position="after">
                    <field name="org_number"/>
                </xpath>
                <xpath expr="//page[@name='lead']//field[@name='function']" position="after">
                    <field name="corporate_form"/>
                    <field name="bolagsfakta_company_link"/>
                    <field name="municipality"/>
                    <field name="industry"/>
                    <field name="employee_range"/>
                </xpath>
                <field name="team_id" position="after">
                    <field name="crm_bolagsfakta_id"/>
                </field>
                <xpath expr="//page[@name='lead']" position="after">
                    <page string="Financial Data" name="fin_data">
                        <group>
                            <group>
                                <field name="omsattning"/>
                                <field name="arets_resultat"/>
                                <field name="ebitda"/>
                                <field name="utdelning"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>