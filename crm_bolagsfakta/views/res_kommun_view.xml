<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_kommun_form" model="ir.ui.view">
            <field name="name">res.kommun.form</field>
            <field name="model">res.kommun</field>
            <field name="arch" type="xml">
                <form string="SNI">
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="code" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_kommun_tree" model="ir.ui.view">
            <field name="name">res.kommun.tree</field>
            <field name="model">res.kommun</field>
            <field name="arch" type="xml">
                <list string="Code">
                    <field name="name" />
                    <field name="code" />
                </list>
            </field>
        </record>

        <record id="view_kommun_filter" model="ir.ui.view">
            <field name="name">res.kommun.select</field>
            <field name="model">res.kommun</field>
            <field name="arch" type="xml">
                <search string="Search SNI">
                    <field name="name"/>
                    <field name="code" />
                </search>
            </field>
        </record>

        <record id="action_kommun_form" model="ir.actions.act_window">
            <field name="name">Kommun</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.kommun</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="search_view_id" ref="view_kommun_filter" />
        </record>

        <menuitem id="menu_kommun_form" parent="contacts.res_partner_menu_config" action="action_kommun_form" sequence="50" />
    </data>
</odoo>
