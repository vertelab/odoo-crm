<odoo>
    <data>
        <record id="res_partner_view_form" model="ir.ui.view">
            <field name="name">res.partner</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[last()]" position="after">
                    <page string="Bolagsfakta" name="bolagsfakta">
                        <group>
                            <group>
                                <field name="corporate_form"/>
                                <field name="bolagsfakta_company_link"/>
<!--                                <field name="municipality"/>-->
                                <field name="industry"/>
                                <field name="employee_range"/>
                            </group>
                            <group>
                                <field name="org_number"/>
                            </group>
                            <group string="Financial Data">
                                <field name="omsattning"/>
                                <field name="arets_resultat"/>
                                <field name="ebitda"/>
                                <field name="utdelning"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>