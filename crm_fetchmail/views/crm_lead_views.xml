<odoo>

<record id="view_crm_lead_kanban" model="ir.ui.view">
        <field name="name">crm.lead.fetch.mail.kanban</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm_iap_mine.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <button name="action_generate_leads" position="after">
                   <button name="action_force_fetch_mail" type="object" string="Fetch Mail" display="always" invisible="context.get('active_model', 'crm.lead') != 'crm.lead'"/>
            </button>
        </field>
</record> 

<record id="crm_case_tree_view_oppor" model="ir.ui.view">
        <field name="name">crm.lead.fetch.mail.list.opportunity</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <header position="inside">
                  <!-- <button name="action_force_fetch_mail" type="object" string="Fetch Mail" display="always" invisible="context.get('active_model', 'crm.lead') != 'crm.lead'"/> -->
                   <button name="action_force_fetch_mail" type="object" string="Fetch Mail" display="always" />
            </header>
        </field>
</record>

</odoo>
