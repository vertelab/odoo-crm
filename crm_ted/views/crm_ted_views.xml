<odoo>
	<data>

		<record model="ir.ui.view" id="crm_ted_form">
			<field name="name">crm.ted.from</field>
			<field name="model">crm.ted</field>
			<field name="arch" type="xml">
				<form>
					<sheet string="Ted">
						<group>
							<group>
								<field name="ted_title" />
								<field name="ted_tender_id" />
							</group>
						</group>
						<group>
							<field name="ted_description" />
						</group>
						<group>
							<group>
								<field name="ted_link" />
								<field name="ted_estimated_value" widget="monetary"/>
								<field name="ted_org_name" />
								<field name="ted_address" />
								<field name="ted_city" />
								<field name="ted_zip" />
								<field name="ted_country_code" />
								<field name="ted_country" />
								<field name="ted_contact" />
								<field name="ted_phone" />
								<field name="ted_email" />
								<field name="ted_currency_id" />
							</group>
							<group>
								<field name="ted_pdf_name" invisible="1"/>
								<field name="ted_xml_name" invisible="1"/>
								<field name="ted_pdf" filename="ted_pdf_name" />
								<field name="ted_xml" filename="ted_xml_name"/>
								<field name="ted_publication_date" />
								<field name="ted_participation_period" />
								<field name="ted_additional_information_period" />
							</group>
						</group>
						<group>
							<separator/>
						</group>
					</sheet>
				</form>
			</field>
		</record>

		<record model="ir.ui.view" id="crm_ted_list">
			<field name="name">crm.ted.from</field>
			<field name="model">crm.ted</field>
			<field name="arch" type="xml">
				<tree>
					<header>
						<button name="create_records" type="object" string="Get Tenders" display="always" class="oe_highlight" />
					</header>
					<div name="button_box" class="oe_button_box">
						<button class="oe_stat_button" type="object" name="go_to_leads_action" icon="fa-list" invisible="crm_lead_count == 0">
							<field string="Leads" name="crm_lead_count" widget="statinfo"/>
						</button>
					</div>
					<field name="ted_title" />
					<field name="ted_tender_id" />
					<field name="ted_estimated_value" widget="monetary"/>
					<field name="ted_org_name" optional="hide"/>
					<field name="ted_address" optional="hide"/>
					<field name="ted_city" optional="hide"/>
					<field name="ted_zip" optional="hide"/>
					<field name="ted_country_code" optional="hide" />
					<field name="ted_country" optional="hide"/>
					<field name="ted_contact" optional="hide"/>
					<field name="ted_phone" optional="hide"/>
					<field name="ted_email" optional="hide" />
					<field name="ted_currency_id" optional="hide"/>
					<field name="ted_publication_date" optional="hide"/>
					<field name="ted_participation_period" optional="hide"/>
					<field name="ted_additional_information_period" optional="hide"/>
				</tree>
			</field>
		</record>


		<record id="crm_ted_server_action" model="ir.actions.server">
			<field name="name">Create Lead</field>
			<field name="model_id" ref="crm_ted.model_crm_ted"/>
			<field name="binding_model_id" ref="crm_ted.model_crm_ted"/>
			<field name="state">code</field>
			<field name="code">
				for record in records:
					record.create_lead()
			</field>
		</record>

		<record model="ir.actions.act_window" id="crm_ted_action">
			<field name="name">TED</field>
			<field name="res_model">crm.ted</field>
			<field name="view_mode">tree,form</field>
			<field name="target">current</field>
		</record>

		<menuitem id="crm_menu_leads" name="Leads" parent="crm.crm_menu_root" sequence="1"/>

		<menuitem id="menu_crm_leads" name="TED" parent="crm_menu_leads" action="crm_ted.crm_ted_action" sequence="1"/>

	</data>
</odoo>
