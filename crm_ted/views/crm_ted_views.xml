<odoo>
	<data>

		<record model="ir.ui.view" id="crm_ted_form">
			<field name="name">crm.ted.from</field>
			<field name="model">crm.ted</field>
			<field name="arch" type="xml">
				<form>
					<sheet string="Ted">
						<group>
							<group>
								<field name="ted_title" />
								<field name="ted_tender_id" />
							</group>
						</group>
						<group>
							<field name="ted_description" />
						</group>
						<group>
							<group>
								<field name="ted_link" />
								<field name="ted_estimated_value" />
								<field name="ted_cpv" />
								<field name="ted_participation_period" />
								<field name="ted_additional_information_period" />
							</group>
							<group>
								<field name="ted_pdf" />
								<field name="ted_xml" />
								<field name="ted_publication_date" />
							</group>
						</group>
						<group>
							<separator/>
						</group>
					</sheet>
				</form>
			</field>
		</record>

		<record model="ir.ui.view" id="crm_ted_list">
			<field name="name">crm.ted.from</field>
			<field name="model">crm.ted</field>
			<field name="arch" type="xml">
				<tree>
					<header>
						<button name="create_records" type="object" string="Test" display="always" class="oe_highlight" />
					</header>
					<field name="ted_title" />
				</tree>
			</field>
		</record>

		<record model="ir.actions.act_window" id="crm_ted_action">
			<field name="name">Test</field>
			<field name="res_model">crm.ted</field>
			<field name="view_mode">tree,form</field>
			<field name="target">current</field>
		</record>

		<menuitem name="Ted" id="crm_ted.menu_root" action="crm_ted.crm_ted_action" />

	</data>
</odoo>
