        <record id="crm_tracking_campaign_form" model="ir.ui.view">
            <field name="name">utm.campaign.view.form</field>
            <field name="model">utm.campaign</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="utm.utm_campaign_view_form" />
            <field name="arch" type="xml">
                <!-- <field position="after"> -->
                <xpath expr="//form" position="replace">
                    <form string="Campaign">
                        <header>
<!--                            <button name="invoice_open" type="object" invisible="state not in ('draft', 'proforma2')" string="Validate" class="oe_highlight" groups="account.group_account_invoice"/>-->
                            <field name="state" widget="statusbar" clickable="True" statusbar_colors='{"draft":"blue","open":"red"}' />
                        </header>
                        <sheet>
                            <div class="oe_button_box d-flex justify-content-end" name="button_box">
                                <button class="oe_inline oe_stat_button" type="action" icon="fa-dropbox" name="%(action_crm_campaign_object_view)d" context="{'search_default_campaign_id': active_id}">
                                    <field string="Objects" name="object_count" widget="statinfo"/>
                                </button>
                            </div>

                            <field name="image" widget="image" class="oe_avatar oe_right" />

                            <h1>
                                <field name="name" default_focus="1" placeholder="Campaign" class="oe_inline"/><span class="oe_inline"> </span>
                            </h1>

                            <group>
                                <group>
                                    <field name="date_start" string="Date" widget="daterange" options="{'end_date_field': 'date_stop'}" />
                                    <field name="date_stop" invisible="1" />
                                </group>
                            </group>
                            <notebook>
                                <page string="Objects">
                                    <field name="object_ids">
                                        <tree>
                                            <field name="sequence" widget="handle" />
                                            <field name="name" />
                                            <field name="object_id"/>
<!--                                            <field name="object_ref" />-->
                                        </tree>
                                    </field>
                                </page>

                                <page string="Information">
                                    <field name="description" />
                                </page>
                            </notebook>
                        </sheet>
                        <div class="oe_chatter">
                            <field name="message_follower_ids" widget="mail_followers" />
                            <field name="message_ids" widget="mail_thread" />
                        </div>
                    </form>
                </xpath>
            </field>
        </record>

        <record id="crm_tracking_campaign_calendar" model="ir.ui.view">
            <field name="name">utm.campaign.calendar</field>
            <field name="model">utm.campaign</field>
            <field name="arch" type="xml">
                <calendar string="CRM Tracking Campaign" color="object_names" date_start="date_start" date_stop="date_stop">
                    <field name="name" />
                    <field name="object_names" />
                </calendar>
            </field>
        </record>

        <record id="crm_tracking_campaign_gantt" model="ir.ui.view">
            <field name="name">utm.campaign.gantt</field>
            <field name="model">utm.campaign</field>
            <field name="type">gantt</field>
            <field name="arch" type="xml">
                <gantt date_start="date_start" date_stop="date_stop" string="Campaigns" />
            </field>
        </record>
    </data>
</odoo>
